# ==============================
# MPI + OpenMP EXPERIMENT
# ==============================

# 1. Install Python
sudo apt install python3

# 2. Install MPICH
sudo apt install -y -qq mpich

# 3. Install pip
sudo apt install python3-pip

# 4. Install mpi4py
pip install mpi4py

# 5. Install OpenMPI development library
sudo apt-get install libopenmpi-dev

# 6. Install OpenMPI binaries
sudo apt-get install openmpi-bin

# 7. Create MPI program
gedit mpi_example.py

# 8. Run MPI program
mpirun -np 2 python3 mpi_example.py

# If "not enough slots" error occurs:
mpirun --oversubscribe -np 2 python3 mpi_example.py


# ==============================
# OPENMP
# ==============================

# 9. Install OpenMP
sudo apt-get install libomp-dev


# ---------- SAMPLE 1 ----------
# Hello World

gedit hello_omp.cpp

g++ -fopenmp hello_omp.cpp -o hello_omp.out

./hello_omp.out


