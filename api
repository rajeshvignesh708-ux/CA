// config.js or process.env configuration
const API_URL = 'https://api.example.com/v1/resource';
const API_KEY = process.env.API_KEY;

async function fetchThirdPartyData() {
  try {
    const response = await fetch(
      `${API_URL}?apiKey=${encodeURIComponent(API_KEY)}`
    );

    // Always validate the network response status
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }

    const data = await response.json();
    return data;
  } catch (error) {
    console.error('Failed to retrieve data from API:', error);
    displayErrorToUser('Could not load data. Please try again later.');
    return null;
  }
}


