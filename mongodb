const express = require("express");
const mongoose = require("mongoose");

const app = express();
app.use(express.urlencoded({ extended: true }));

const MONGO_URI = "mongodb+srv://vignesh:asd123@cluster0.lzvyw7v.mongodb.net/studentdb?retryWrites=true&w=majority";

mongoose.connect(MONGO_URI)
    .then(() => app.listen(3000, () => console.log("Server running at http://localhost:3000")))
    .catch(err => { console.log("MongoDB Error:", err.message); process.exit(1); });

const Student = mongoose.model("Student", new mongoose.Schema({
    name: { type: String, required: true },
    email: { type: String, required: true },
    course: { type: String, required: true },
    age: { type: Number, required: true }
}));

const esc = t => String(t ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

// READ (Home Page with Student Table)
app.get("/", async (req, res) => {
    try {
        const students = await Student.find().sort({ _id: -1 });
        const rows = students.map(s => `
            <tr>
                <td>${esc(s.name)}</td><td>${esc(s.email)}</td><td>${esc(s.course)}</td><td>${s.age}</td>
                <td>
                    <div class="actions">
                        <a href="/edit/${s._id}" class="btn btn-edit">Edit</a>
                        <form action="/delete/${s._id}" method="POST" class="inline" onsubmit="return confirm('Delete student?')">
                            <button type="submit" class="btn btn-del">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>`).join("");

        res.send(`<!DOCTYPE html><html><head><title>Student CRUD</title></head><body>
        <h2>Student Management System</h2>
        <form action="/add" method="POST">
            <input name="name" placeholder="Student Name" required>
            <input name="email" type="email" placeholder="Email" required>
            <input name="course" placeholder="Course" required>
            <input name="age" type="number" min="1" placeholder="Age" required>
            <button type="submit">Add Student</button>
        </form>
        <h3>Student Records</h3>
        <table border="1">
            <thead><tr><th>Name</th><th>Email</th><th>Course</th><th>Age</th><th>Actions</th></tr></thead>
            <tbody>${rows || '<tr><td colspan="5">No records found</td></tr>'}</tbody>
        </table>
        </body></html>`);
    } catch (err) {
        res.status(500).send("Unable to load students: " + esc(err.message));
    }
});

// CREATE
app.post("/add", async (req, res) => {
    try {
        const { name, email, course, age } = req.body;
        await Student.create({ name, email, course, age: Number(age) });
        res.redirect("/");
    } catch (err) {
        res.status(400).send("Error adding student: " + esc(err.message));
    }
});

// UPDATE FORM
app.get("/edit/:id", async (req, res) => {
    try {
        const s = await Student.findById(req.params.id);
        if (!s) return res.status(404).send("Student not found");
        res.send(`<!DOCTYPE html><html><head><title>Edit Student</title></head><body>
        <h2>Edit Student</h2>
        <form action="/update/${s._id}" method="POST">
            <p><label>Name</label><br><input name="name" value="${esc(s.name)}" required></p>
            <p><label>Email</label><br><input name="email" type="email" value="${esc(s.email)}" required></p>
            <p><label>Course</label><br><input name="course" value="${esc(s.course)}" required></p>
            <p><label>Age</label><br><input name="age" type="number" min="1" value="${s.age}" required></p>
            <button type="submit">Update</button>
            <a href="/">Cancel</a>
        </form>
        </body></html>`);
    } catch (err) {
        res.status(500).send("Unable to edit student");
    }
});

// UPDATE
app.post("/update/:id", async (req, res) => {
    try {
        const { name, email, course, age } = req.body;
        await Student.findByIdAndUpdate(req.params.id, { name, email, course, age: Number(age) });
        res.redirect("/");
    } catch (err) {
        res.status(400).send("Error updating student");
    }
});

// DELETE
app.post("/delete/:id", async (req, res) => {
    try {
        await Student.findByIdAndDelete(req.params.id);
        res.redirect("/");
    } catch (err) {
        res.status(500).send("Error deleting student");
    }
});


