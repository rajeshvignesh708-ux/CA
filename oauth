##index.html
<!DOCTYPE html>
<html>
<head>
    <title>Hospital Management System</title>
</head>
<body>
    <h2>Hospital Management System</h2>
    <h3>Welcome!</h3>
    <p>Welcome to our Hospital Portal</p>
    <p>Login securely using Auth0</p>

    <button id="loginBtn" disabled>Loading...</button>
    <p id="error"></p>

    <script src="https://cdn.auth0.com/js/auth0-spa-js/2.0/auth0-spa-js.production.js"></script>

    <script>
        const DOMAIN = "dev-kwmjehlefgltqsww.us.auth0.com";
        const CLIENT_ID = "Ngc2uIVQl6mRyEnU1LaGeRLPQH1qWZyb";

        let client;

        async function setup() {
            try {
                client = await auth0.createAuth0Client({
                    domain: DOMAIN,
                    clientId: CLIENT_ID,
                    authorizationParams: {
                        redirect_uri: location.origin + "/welcome.html"
                    }
                });

                const button = document.getElementById("loginBtn");
                button.disabled = false;
                button.textContent = "Login";

                button.onclick = () => client.loginWithRedirect();

            } catch (error) {
                document.getElementById("error").textContent = error.message;
            }
        }

        setup();
    </script>
</body>
</html>



### Auth0 configuration
In Auth0 Dashboard → **Applications → your application → Settings**:
- Application type: **Single Page Application**
- Allowed Callback URLs: `http://localhost:5500/welcome.html`
- Allowed Logout URLs: `http://localhost:5500/index.html`
- Allowed Web Origins: `http://localhost:5500`
- Save changes.

If your browser uses `127.0.0.1` instead of `localhost`, use `127.0.0.1` consistently in all three fields and in the browser.

**Initialize/run (CMD):** Save both files in the same folder, then:
```cmd
cd /d "C:\path\to\your\auth0-folder"
py -m http.server 5500
```
Open `http://localhost:5500/index.html`. Keep CMD open. Auth0 must have the exact callback URLs. If the error says `Unauthorized`, verify Domain and Client ID against the same Auth0 SPA application.


##welcome.html

<!DOCTYPE html>
<html>
<head>
    <title>Book Appointment</title>
</head>
<body>
    <h2>Hospital Management System</h2>

    <p id="status">Checking login...</p>

    <div id="appointment" hidden>
        <h3>Book Appointment</h3>
        <p id="userInfo"></p>

        <form id="appointmentForm">
            <label>Patient Name:</label>
            <input id="patientName" required>
            <br><br>

            <label>Age:</label>
            <input id="age" type="number" min="1" max="120" required>
            <br><br>

            <label>Gender:</label>
            <select id="gender" required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>
            <br><br>

            <button type="submit">Book Appointment</button>
        </form>

        <br>
        <button id="logoutBtn">Logout</button>
    </div>

    <script src="https://cdn.auth0.com/js/auth0-spa-js/2.0/auth0-spa-js.production.js"></script>

    <script>
        const DOMAIN = "dev-kwmjehlefgltqsww.us.auth0.com";
        const CLIENT_ID = "Ngc2uIVQl6mRyEnU1LaGeRLPQH1qWZyb";

        let client;

        async function setup() {
            try {
                client = await auth0.createAuth0Client({
                    domain: DOMAIN,
                    clientId: CLIENT_ID,
                    authorizationParams: {
                        redirect_uri: location.origin + "/welcome.html"
                    }
                });

                if (location.search.includes("code=")) {
                    await client.handleRedirectCallback();
                    history.replaceState({}, document.title, location.pathname);
                }

                if (!(await client.isAuthenticated())) {
                    location.replace("/index.html");
                    return;
                }

                const user = await client.getUser();

                document.getElementById("status").hidden = true;
                document.getElementById("appointment").hidden = false;

                document.getElementById("userInfo").textContent =
                    "Logged in as " + (user.name || user.email || "Patient");

                document.getElementById("logoutBtn").onclick = () => {
                    client.logout({
                        logoutParams: {
                            returnTo: location.origin + "/index.html"
                        }
                    });
                };

            } catch (error) {
                document.getElementById("status").textContent =
                    "Error: " + error.message;
            }
        }

        document.getElementById("appointmentForm").onsubmit = function(event) {
            event.preventDefault();
            alert("Appointment booked successfully! (Demo only)");
            this.reset();
        };

        setup();
    </script>
</body>
</html>
