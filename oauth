### `welcome.html`
```html
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Book Appointment</title>
  <style>
    body{font-family:Arial;background:#eef2f7;margin:0}
    header{background:#34495e;color:white;padding:15px;text-align:center}
    .box{background:white;max-width:400px;margin:40px auto;padding:30px;border-radius:10px;box-shadow:0 4px 15px #ccc}
    input,select{width:100%;padding:10px;margin:10px 0 18px;box-sizing:border-box}
    label{display:block}
    button{background:#34495e;color:white;padding:12px;width:100%;border:0;border-radius:5px;cursor:pointer;margin-top:10px}
  </style>
</head>
<body>
<header><h2>Hospital Management System</h2></header>
<p id="status" style="text-align:center">Checking login...</p>
<div class="box" id="appointment" hidden>
  <h2>Book Appointment</h2>
  <p id="userInfo"></p>
  <form id="appointmentForm">
    <label>Patient Name</label><input id="patientName" required placeholder="Enter patient name">
    <label>Age</label><input id="age" type="number" min="1" max="120" required placeholder="Enter age">
    <label>Gender</label>
    <select id="gender" required>
      <option value="">Select Gender</option><option>Male</option><option>Female</option><option>Other</option>
    </select>
    <button type="submit">Book Appointment</button>
  </form>
  <button id="logoutBtn">Logout</button>
</div>
<script src="https://cdn.auth0.com/js/auth0-spa-js/2.0/auth0-spa-js.production.js"></script>
<script>
  const DOMAIN = "dev-kwmjehlefgltqsww.us.auth0.com";
  const CLIENT_ID = "t8XFmgj13qSMebnBx2CzuYwz4awd1oaY";
  let client;

  async function setup() {
    try {
      client = await auth0.createAuth0Client({
        domain: DOMAIN,
        clientId: CLIENT_ID,
        authorizationParams: { redirect_uri: location.origin + "/welcome.html" }
      });

      if (location.search.includes("code=") && location.search.includes("state=")) {
        await client.handleRedirectCallback();
        history.replaceState({}, document.title, location.pathname);
      }

      if (!(await client.isAuthenticated())) {
        location.replace(location.origin + "/index.html");
        return;
      }

      const user = await client.getUser();
      document.getElementById("status").hidden = true;
      document.getElementById("appointment").hidden = false;
      document.getElementById("userInfo").textContent =
        "Logged in as " + (user.name || user.email || "Patient");
      document.getElementById("logoutBtn").onclick = () => client.logout({
        logoutParams: { returnTo: location.origin + "/index.html" }
      });
    } catch (error) {
      document.getElementById("status").textContent = "Auth0 error: " + error.message;
      console.error(error);
    }
  }

  document.getElementById("appointmentForm").addEventListener("submit", event => {
    event.preventDefault();
    alert("Appointment form submitted. This demo does not save data.");
    event.target.reset();
  });
  setup();
</script>
</body>
</html>
```

### Auth0 configuration
In Auth0 Dashboard → **Applications → your application → Settings**:
- Application type: **Single Page Application**
- Allowed Callback URLs: `http://localhost:5500/welcome.html`
- Allowed Logout URLs: `http://localhost:5500/index.html`
- Allowed Web Origins: `http://localhost:5500`
- Save changes.

If your browser uses `127.0.0.1` instead of `localhost`, use `127.0.0.1` consistently in all three fields and in the browser.

**Initialize/run (CMD):** Save both files in the same folder, then:
```cmd
cd /d "C:\path\to\your\auth0-folder"
py -m http.server 5500
```
Open `http://localhost:5500/index.html`. Keep CMD open. Auth0 must have the exact callback URLs. If the error says `Unauthorized`, verify Domain and Client ID against the same Auth0 SPA application.
